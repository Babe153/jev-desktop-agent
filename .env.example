# Official TypeSafe credential. Never use OPENAI_API_KEY for Jev.
TYPESAFE_API_KEY=
# App configuration: these names are read by this demo, not by an SDK.
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=30
JEV_MIN_CONFIDENCE=0.50

# Local speech recognition. First use downloads the Whisper model.
WHISPER_MODEL=small
WHISPER_LANGUAGE=zh
# Leave blank for default microphone.
MIC_DEVICE=
# Pause length before a complete utterance is automatically sent to Jev.
SPEECH_SILENCE_SECONDS=1.0
# Raise for noisy rooms, lower if quiet speech is not detected.
SPEECH_RMS_THRESHOLD=0.012
# Interval for interim transcripts (actual speed depends on your CPU).
SPEECH_PARTIAL_INTERVAL=1.0
# Optional: Windows Camera's custom save directory. Blank uses the system Camera Roll.
CAMERA_ROLL_DIR=
# Relative to project directory; files stay inside this directory.
WORKSPACE_DIR=data/workspace
